# ---------------------------------------------------------------------------
# Nexus Care web — copy to apps/web/.env.local if you need to override defaults.
# Only PUBLIC values belong here: everything prefixed with VITE_ is bundled into
# the browser. Never put secrets or service keys in this file.
# ---------------------------------------------------------------------------

# Base URL of the API. Leave empty to use same-origin requests (the Vite dev server
# proxies /api to API_PROXY_TARGET). Set to e.g. https://api.nexuscare.example in production
# if the API is served from a different origin.
VITE_API_BASE_URL=

# Dev-server only (not bundled): where the Vite proxy forwards /api requests.
API_PROXY_TARGET=http://localhost:4000

# Public contact address for the Contact page. When set, the contact form opens the
# visitor's email app addressed to it (there is no contact backend). Leave empty to
# show the form in a disabled state with an explanation.
VITE_CONTACT_EMAIL=
