# ---------------------------------------------------------------------------
# Nexus Care API — copy to apps/api/.env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection string.
#  - Supabase: Project Settings → Database → Connection string (use the pooler URI).
#  - Local (no Docker): run `npm run db:local` and use the URL it prints.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/nexuscare

# disable | require | verify-full
#  - disable:     local development database only.
#  - require:     encrypted connection without certificate verification.
#  - verify-full: encrypted + certificate verification (recommended for Supabase;
#                 set DATABASE_SSL_CA_FILE to the downloaded Supabase CA certificate).
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_FILE=

# --- Sessions (Phase 3) -------------------------------------------------------
# Sign out after this much inactivity (minutes) and after this total lifetime (hours).
SESSION_IDLE_TIMEOUT_MINUTES=720
SESSION_ABSOLUTE_TIMEOUT_HOURS=168
# true (default): cookie is HTTPS-only with the __Host- prefix — required in production.
# false: only for plain-HTTP local development (http://localhost).
SESSION_COOKIE_SECURE=false

# --- Admin provisioning (optional) ----------------------------------------------
# Used by `npm run admin:create`; if unset the script prompts for the password.
# NEXUSCARE_ADMIN_PASSWORD=
